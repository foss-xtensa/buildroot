From 777a93124bb910a1ce9b9e3bf6bef190684cd921 Mon Sep 17 00:00:00 2001
From: William Tambe <williamt@cadence.com>
Date: Tue, 13 Jan 2026 08:08:54 -0800
Subject: [PATCH] xtensa: flush_module_icache() hang workaround

Signed-off-by: William Tambe <williamt@cadence.com>
---
 arch/xtensa/include/asm/cacheflush.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/xtensa/include/asm/cacheflush.h b/arch/xtensa/include/asm/cacheflush.h
index a2b6bb542..ba9d7241f 100644
--- a/arch/xtensa/include/asm/cacheflush.h
+++ b/arch/xtensa/include/asm/cacheflush.h
@@ -150,7 +150,7 @@ void local_flush_cache_page(struct vm_area_struct *vma,
 #define local_flush_icache_range(start, end)				\
 	do {								\
 		__flush_dcache_range(start, (end) - (start));		\
-		__invalidate_icache_range(start,(end) - (start));	\
+		__invalidate_icache_all();				\
 	} while (0)
 
 #if defined(CONFIG_MMU) && (DCACHE_WAY_SIZE > PAGE_SIZE)
-- 
2.43.0

